{
  "name": "aqa-lab-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AQA Lab — интерактивный учебник и практическое приложение",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "runner": "node runner/server.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:content": "node scripts/check-content.mjs",
    "import-glossary": "node scripts/import-glossary.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@electric-sql/pglite": "0.5.8",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "markdown-it": "15.0.2",
    "pyodide": "314.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.3"
  }
}
