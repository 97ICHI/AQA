{
  "name": "aqa-lab-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test:api": "node --test tests/api.node.test.mjs",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm run test:api && npm test",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "pretest": "node clean-results.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.0",
    "allure-commandline": "2.36.0",
    "allure-playwright": "3.4.5",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "engines": {
    "node": ">=22"
  }
}
